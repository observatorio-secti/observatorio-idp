# Ambiente e Servidor
ENVIRONMENT=development
PROJECT_NAME=observatorio-idp
IDP_ISSUER=http://localhost:8000
# Prefixo público quando o IdP fica atrás de proxy em subcaminho (ex.: /idp).
# Lido pelo entrypoint.sh do container e repassado ao uvicorn como --root-path.
# ROOT_PATH=/idp

# Banco de Dados
DATABASE_URL=sqlite+aiosqlite:///./observatorio_idp.db

# Chaves Criptográficas e JWT (Se vazio, gera RSA 2048 bits dinamicamente)
IDP_PRIVATE_KEY_PEM=
IDP_KEY_ID=default-kid
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30
AUTHORIZATION_CODE_EXPIRE_MINUTES=5

# Frontend
FRONTEND_AUTH_CALLBACK_URL=http://localhost:3000/auth/callback

# Administrador Inicial (Bootstrap automático no startup)
ADMIN_EMAIL=admin@observatorio.ba.gov.br
ADMIN_NAME=Administrador Observatório
ADMIN_PASSWORD=admin_secret_password

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback

# ORCID OAuth
ORCID_CLIENT_ID=
ORCID_CLIENT_SECRET=
ORCID_REDIRECT_URI=http://localhost:8000/auth/orcid/callback
ORCID_SANDBOX=true
